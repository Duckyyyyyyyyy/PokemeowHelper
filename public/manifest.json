{
  "manifest_version": 3,
  "name": "MeowHelper – PokeMeowRPG Battle Helper",
  "short_name": "MeowHelper",
  "version": "0.7.0",
  "description": "Look up NPC teams and get team suggestions for PokeMeowRPG. Advice only – it never plays for you.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open MeowHelper", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "unlimitedStorage", "storage"],
  "host_permissions": ["https://pokemeowrpg.com/*"],
  "content_scripts": [{ "matches": ["https://pokemeowrpg.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
