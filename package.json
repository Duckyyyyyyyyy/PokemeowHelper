{
  "name": "meowhelper",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "MeowHelper – advisory battle helper for PokeMeowRPG (Chrome side panel extension)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.content.config.ts && node scripts/check-content.mjs",
    "test": "vitest run",
    "fixture": "tsx scripts/make-fixture.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "package": "npm run build && tsx scripts/package.ts"
  },
  "dependencies": {
    "@fontsource/nunito": "5.1.0",
    "@preact/signals": "1.3.0",
    "@smogon/calc": "^0.12.0",
    "acorn": "8.12.1",
    "idb": "8.0.0",
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.9.1",
    "@types/chrome": "0.0.280",
    "@types/node": "^22.9.0",
    "fake-indexeddb": "6.0.0",
    "happy-dom": "^15.11.6",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
